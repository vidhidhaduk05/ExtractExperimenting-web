# Dockerfile for container-based AWS Lambda deployment of RadExtract.
#
# The Antigravity SDK includes a compiled Go binary (~200MB) that exceeds
# the 250MB ZIP Lambda limit. Container-based Lambda supports up to 10GB
# images, making it the required deployment method when antigravity_enabled=true.
#
# Build:
#   docker build -t radextract-lambda -f deploy/Dockerfile.lambda .
# Push to ECR:
#   aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin <account>.dkr.ecr.us-east-1.amazonaws.com
#   docker tag radextract-lambda:latest <account>.dkr.ecr.us-east-1.amazonaws.com/radextract-lambda:latest
#   docker push <account>.dkr.ecr.us-east-1.amazonaws.com/radextract-lambda:latest
#
# The Lambda handler is lambda_handler.handler (Mangum ASGI adapter).

FROM public.ecr.aws/lambda/python:3.11

# Copy requirements and install dependencies
COPY deploy/requirements-lambda.txt ${LAMBDA_TASK_ROOT}/requirements.txt
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt

# Copy backend application code
COPY radextract_platform/backend/ ${LAMBDA_TASK_ROOT}/

# Remove development artifacts that bloat the image
RUN rm -rf ${LAMBDA_TASK_ROOT}/tests \
           ${LAMBDA_TASK_ROOT}/__pycache__ \
           ${LAMBDA_TASK_ROOT}/routers/__pycache__ \
           ${LAMBDA_TASK_ROOT}/services/__pycache__ \
           ${LAMBDA_TASK_ROOT}/uploads \
           ${LAMBDA_TASK_ROOT}/exports \
           ${LAMBDA_TASK_ROOT}/radextract.db \
           ${LAMBDA_TASK_ROOT}/*.pyc

# Set the Lambda handler
CMD [ "lambda_handler.handler" ]
