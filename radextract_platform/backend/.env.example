# Backend environment variables
# Copy to .env and adjust as needed
# All variables use the RADEXTRACT_ prefix

# Environment
RADEXTRACT_ENV=development

# JWT (MUST be set in production)
# RADEXTRACT_JWT_SECRET=your-secret-here
# RADEXTRACT_JWT_ALGORITHM=HS256
# RADEXTRACT_JWT_EXPIRE_MINUTES=15

# LLM Gateway (gemini-web2api)
RADEXTRACT_LLM_API_URL=http://127.0.0.1:8081/v1/chat/completions
RADEXTRACT_LLM_API_KEY=sk-gemini
RADEXTRACT_LLM_MODELS_URL=http://127.0.0.1:8081/v1/models
RADEXTRACT_LLM_MODEL=gemini-3.7-flash

# TypeSafe Jev screening (optional). off = existing LLM screening only (default)
#   shadow = run Jev alongside and log JEV_SHADOW comparisons, still return the LLM result
#   on     = use Jev, fall back to the LLM if Jev fails
# RADEXTRACT_JEV_MODE=off
# RADEXTRACT_JEV_API_KEY=            # or set TYPESAFE_API_KEY
# RADEXTRACT_JEV_INCLUDE_THRESHOLD=0.75
# RADEXTRACT_JEV_EXCLUDE_THRESHOLD=0.85

# CORS (comma-separated or JSON list)
# RADEXTRACT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database & Storage Selection
RADEXTRACT_DB_BACKEND=sqlite
RADEXTRACT_STORAGE_BACKEND=local
# RADEXTRACT_DB_PATH=./radextract.db
# RADEXTRACT_UPLOAD_ROOT=./uploads
# RADEXTRACT_EXPORT_ROOT=./exports

# AWS / LocalStack (local development: point to LocalStack at :4566)
RADEXTRACT_AWS_ENDPOINT_URL=http://localhost:4566
RADEXTRACT_AWS_REGION=us-east-1
RADEXTRACT_AWS_ACCESS_KEY_ID=test
RADEXTRACT_AWS_SECRET_ACCESS_KEY=test
RADEXTRACT_S3_PDF_BUCKET=radextract-pdfs
RADEXTRACT_S3_EXPORT_BUCKET=radextract-exports
RADEXTRACT_DYNAMODB_TABLE_PREFIX=radextract_

# For real AWS production: unset RADEXTRACT_AWS_ENDPOINT_URL
# and supply IAM credentials via standard AWS IAM execution role or env vars
