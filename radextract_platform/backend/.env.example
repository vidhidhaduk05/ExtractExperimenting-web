# =================================================================
# RadExtract Platform — Environment Configuration Template
# Copy this file to .env before starting containers: cp .env.example .env
# =================================================================

# ── 1. Domain & Auto-HTTPS ──
# Set your domain for automatic Let's Encrypt SSL/TLS certificates.
# For local testing, use localhost or your server's IP address.
DOMAIN=localhost

# ── 2. Security & Authentication ──
# Strong random secret key for JWT access tokens.
# Generate one with: openssl rand -hex 32
SECRET_KEY=radextract-replace-with-a-secure-random-secret-key-32chars

# Initial administrator credentials (seeded on first run via seed.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
# Admin / Contact email address (masked template default)
ADMIN_EMAIL=admin@example.com

# ── 3. Cross-Origin Resource Sharing (CORS) ──
# Comma-separated list of allowed frontend origins.
# GitHub Pages deployment is included by default.
CORS_ORIGINS=https://vidhidhaduk05.github.io,http://localhost:5173,http://localhost:3000

# ── 4. LLM Provider (OpenAI-compatible endpoint) ──
# Supports local gemini-web2api, Ollama, vLLM, OpenAI, or LiteLLM
LLM_BASE_URL=http://127.0.0.1:8081/v1/chat/completions
LLM_API_KEY=sk-gemini
LLM_MODEL=gemini-2.5-flash

# ── 5. Storage & Database Paths (Container Paths) ──
RADEXTRACT_ENV=production
RADEXTRACT_DB_PATH=/data/db/radextract.db
RADEXTRACT_UPLOAD_ROOT=/data/pdfs
RADEXTRACT_EXPORT_ROOT=/data/exports
